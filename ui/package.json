{
  "name": "teutates-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o ../server/dist/assets/styles.css --minify",
    "build:js": "esbuild src/main.ts --bundle --format=esm --target=es2022 --minify --outfile=../server/dist/assets/app.js",
    "build": "npm run build:css && npm run build:js && npm run build:html",
    "watch:css": "tailwindcss -i src/input.css -o ../server/dist/assets/styles.css --watch",
    "watch:js": "esbuild src/main.ts --bundle --format=esm --target=es2022 --outfile=../server/dist/assets/app.js --watch",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/*.test.ts test/taskwarrior/*.test.ts --bundle --platform=node --format=esm --packages=external --outbase=test --outdir=.test-build && node --test .test-build/*.js .test-build/taskwarrior/*.js",
    "build:html": "cp index.html ../server/dist/index.html",
    "start": "node ../server/teutates.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.14",
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.25.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
