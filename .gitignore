# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/
build/

# Generated UI bundle, embedded into the binary at build time.
# The directory itself is tracked so `go:embed` has something to match on a
# fresh clone, before the UI has ever been built.
backend/webui/*
!backend/webui/.gitkeep
ui/.test-build/

# Environment
.env
.env.local
.env.*.local

# OS
Thumbs.db
.DS_Store

# Logs
*.log
logs/

# Temp
tmp/
temp/
